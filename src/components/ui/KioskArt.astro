---
// Fotoğrafı olmayan kiosk için sade çizim (yer tutucu). Süs amaçlıdır (aria-hidden);
// başka bir modelin fotoğrafını göstermekten iyidir. Stil: global.css > .photo-ph
interface Props {
  art?: 'standart' | 'totem' | 'desk';
}
const { art = 'standart' } = Astro.props;
---

<div class="photo photo-ph" aria-hidden="true">
  <svg viewBox="0 0 80 100">
    {art === 'standart' && <><rect x="22" y="6" width="36" height="52" rx="4" fill="currentColor"/><rect x="26" y="10" width="28" height="44" rx="2" fill="#fff"/><rect x="36" y="58" width="8" height="26" fill="currentColor"/><rect x="24" y="84" width="32" height="6" rx="3" fill="currentColor"/></>}
    {art === 'totem' && <><rect x="26" y="4" width="28" height="70" rx="4" fill="currentColor"/><rect x="30" y="8" width="20" height="62" rx="2" fill="#fff"/><rect x="22" y="74" width="36" height="16" rx="3" fill="currentColor"/></>}
    {art === 'desk' && <><rect x="10" y="22" width="60" height="38" rx="4" fill="currentColor"/><rect x="14" y="26" width="52" height="30" rx="2" fill="#fff"/><rect x="30" y="60" width="20" height="10" fill="currentColor"/><rect x="18" y="70" width="44" height="6" rx="3" fill="currentColor"/></>}
  </svg>
</div>
