---
// Özel tasarımlı dropdown. Gizli bir native <select> içerir; form verisi, change olayı
// ve required gibi davranışlar o select üzerinden çalışır.
// Dışarıdan seçenek/disabled/değer değiştirirseniz select'e `dropdown:sync` olayı gönderin.
export interface Option {
  value: string;
  label?: string;
  disabled?: boolean;
}
interface Props {
  name: string;
  options: (string | Option)[];
  value?: string;
  placeholder?: string; // verilirse boş değerli ilk seçenek olarak eklenir
  label?: string; // ekran okuyucu adı
  labelledby?: string; // görünür etiketin id'si
  required?: boolean;
}
const { name, options, value = '', placeholder, label, labelledby, required = false } = Astro.props;

const items: Option[] = options.map((o) => (typeof o === 'string' ? { value: o } : o));
if (placeholder !== undefined) items.unshift({ value: '', label: placeholder });
const text = (o: Option) => o.label ?? o.value;
const selectedIdx = Math.max(0, items.findIndex((o) => o.value === value));
const uid = `dd-${name}-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="dd" data-dd>
  <select class="dd-native" name={name} required={required} tabindex="-1" aria-hidden="true">
    {items.map((o, i) => <option value={o.value} selected={i === selectedIdx} disabled={o.disabled}>{text(o)}</option>)}
  </select>
  <button
    type="button"
    class:list={['dd-trigger', { 'is-placeholder': placeholder !== undefined && selectedIdx === 0 }]}
    role="combobox"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${uid}-list`}
    aria-label={labelledby ? undefined : label}
    aria-labelledby={labelledby}
  >
    <span class="dd-value">{text(items[selectedIdx])}</span>
    <span class="dd-chevron" aria-hidden="true"></span>
  </button>
  <ul class="dd-menu" id={`${uid}-list`} role="listbox" hidden>
    {items.map((o, i) => (
      <li
        id={`${uid}-o${i}`}
        role="option"
        class:list={['dd-opt', { 'is-placeholder': placeholder !== undefined && i === 0, 'is-selected': i === selectedIdx, 'is-disabled': o.disabled }]}
        aria-selected={i === selectedIdx}
        aria-disabled={o.disabled ? 'true' : undefined}
      >{text(o)}</li>
    ))}
  </ul>
</div>

<script>
  function init(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const select = root.querySelector<HTMLSelectElement>('select')!;
    const trigger = root.querySelector<HTMLButtonElement>('.dd-trigger')!;
    const menu = root.querySelector<HTMLElement>('.dd-menu')!;
    const value = root.querySelector<HTMLElement>('.dd-value')!;
    const els = Array.from(menu.querySelectorAll<HTMLElement>('.dd-opt'));
    const opts = Array.from(select.options);
    const hasPlaceholder = els[0]?.classList.contains('is-placeholder');
    let active = -1;
    let typed = '';
    let typedTimer: number | undefined;

    const isOpen = () => !menu.hidden;

    function refresh() {
      const sel = select.selectedIndex;
      value.textContent = opts[sel]?.textContent ?? '';
      trigger.classList.toggle('is-placeholder', !!hasPlaceholder && sel === 0);
      els.forEach((el, i) => {
        el.classList.toggle('is-selected', i === sel);
        el.setAttribute('aria-selected', String(i === sel));
        el.classList.toggle('is-disabled', opts[i].disabled);
        if (opts[i].disabled) el.setAttribute('aria-disabled', 'true');
        else el.removeAttribute('aria-disabled');
      });
    }

    function setActive(i: number, scroll = true) {
      els[active]?.classList.remove('is-active');
      active = i;
      if (!els[i]) { trigger.removeAttribute('aria-activedescendant'); return; }
      els[i].classList.add('is-active');
      trigger.setAttribute('aria-activedescendant', els[i].id);
      if (scroll) els[i].scrollIntoView({ block: 'nearest' });
    }

    function step(from: number, dir: 1 | -1) {
      for (let i = from + dir; i >= 0 && i < opts.length; i += dir) if (!opts[i].disabled) return i;
      return from;
    }

    function open() {
      if (isOpen() || select.disabled) return;
      document.querySelectorAll('.dd.is-open').forEach((d) => d.dispatchEvent(new Event('dd:close')));
      menu.hidden = false;
      const r = trigger.getBoundingClientRect();
      const below = window.innerHeight - r.bottom;
      root.classList.toggle('is-up', below < 260 && r.top > below);
      root.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      setActive(select.selectedIndex);
    }

    function close() {
      if (!isOpen()) return;
      menu.hidden = true;
      root.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      setActive(-1);
    }

    function choose(i: number) {
      const changed = select.selectedIndex !== i;
      select.selectedIndex = i;
      refresh();
      close();
      trigger.focus();
      if (changed) {
        select.dispatchEvent(new Event('input', { bubbles: true }));
        select.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    els.forEach((el, i) => {
      el.addEventListener('mousedown', (e) => e.preventDefault());
      el.addEventListener('click', () => { if (!opts[i].disabled) choose(i); });
      el.addEventListener('mousemove', () => { if (!opts[i].disabled) setActive(i, false); });
    });

    trigger.addEventListener('click', () => (isOpen() ? close() : open()));

    trigger.addEventListener('keydown', (e) => {
      const k = e.key;
      if (k === 'Tab') { close(); return; }
      if (k === 'Escape') { if (isOpen()) { e.preventDefault(); close(); } return; }
      if (k === 'ArrowDown' || k === 'ArrowUp') {
        e.preventDefault();
        if (!isOpen()) { open(); return; }
        setActive(step(active, k === 'ArrowDown' ? 1 : -1));
      } else if (k === 'Home' || k === 'End') {
        if (!isOpen()) return;
        e.preventDefault();
        setActive(k === 'Home' ? step(-1, 1) : step(opts.length, -1));
      } else if (k === 'Enter' || k === ' ') {
        if (k === ' ' && typed) return;
        e.preventDefault();
        if (!isOpen()) open();
        else if (active >= 0) choose(active);
      } else if (k.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        typed += k.toLocaleLowerCase('tr');
        window.clearTimeout(typedTimer);
        typedTimer = window.setTimeout(() => { typed = ''; }, 600);
        const from = isOpen() ? active : select.selectedIndex;
        const hit = [...opts.keys()]
          .map((n) => (n + from + (typed.length > 1 ? 0 : 1)) % opts.length)
          .find((n) => !opts[n].disabled && (opts[n].textContent ?? '').toLocaleLowerCase('tr').startsWith(typed));
        if (hit !== undefined) (isOpen() ? setActive(hit) : choose(hit));
      }
    });

    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) close(); });
    root.addEventListener('dd:close', close);
    select.addEventListener('change', refresh);
    select.addEventListener('dropdown:sync', refresh);
    select.form?.addEventListener('reset', () => setTimeout(refresh));
  }

  document.querySelectorAll<HTMLElement>('[data-dd]').forEach(init);
</script>
