---
// Ürünün kapak görseli: ilk fotoğrafı, fotoğrafı yoksa model tipine uygun sade bir kiosk çizimi.
import Photo from './Photo.astro';
import KioskArt from './KioskArt.astro';
import { photosOf, productPhotoGroups } from '../../data/galeri';

interface Props {
  slug: string;
  alt?: string;
  size?: 'thumb' | 'large';
  eager?: boolean;
}
const { slug, alt, size = 'thumb', eager = false } = Astro.props;
const photo = photosOf(...(productPhotoGroups[slug] ?? []))[0];
const art = slug === 'desk-kiosk' ? 'desk' : slug === 'totem-kiosk' || slug === 'haritalama-kiosk' ? 'totem' : 'standart';
---

{photo ? <Photo photo={photo} alt={alt} size={size} eager={eager} /> : <KioskArt art={art} />}
