---
// Veri dosyalarındaki başlıklı metin bölümlerini (ContentSection) yazar: paragraf, liste, tablo.
import type { ContentSection, ContentListItem } from '../../types';

interface Props {
  sections: ContentSection[];
}
const { sections } = Astro.props;
const item = (x: string | ContentListItem) => (typeof x === 'string' ? { text: x } : x);
---

{sections.map((s) => {
  const List = s.ordered ? 'ol' : 'ul';
  return (
    <>
      <h2>{s.heading}</h2>
      {s.paragraphs?.map((t) => <p>{t}</p>)}
      {s.list && (
        <List class={s.ordered ? 'steps' : 'ticks'}>
          {s.list.map(item).map((x) => (
            <li>
              {x.label && <><strong>{x.label}:</strong>{' '}</>}
              {x.href ? <a href={x.href}>{x.text}</a> : x.text}
            </li>
          ))}
        </List>
      )}
      {s.table && (
        <div class="table-wrap">
          <table class="spec">
            <thead><tr><th scope="col">{s.table.head[0]}</th><th scope="col">{s.table.head[1]}</th></tr></thead>
            <tbody>{s.table.rows.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
          </table>
        </div>
      )}
      {s.after?.map((t) => <p>{t}</p>)}
    </>
  );
})}

<style>
  /* adım adım numaralı liste */
  .steps { margin: 0 0 1.2rem; padding-left: 1.4rem; }
  .steps li { margin-bottom: .5rem; padding-left: .3rem; }
  .steps li::marker { color: var(--brand); font-weight: 700; }
  /* iki sütunlu teknik özellik tablosu; dar ekranda yatay kaydırılır */
  .table-wrap { overflow-x: auto; margin: 0 0 1.2rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .spec { width: 100%; border-collapse: collapse; font-size: .97rem; }
  .spec th, .spec td { padding: .6rem .9rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .spec thead th { background: var(--brand-soft); color: var(--brand-dark); }
  .spec tbody th { width: 38%; font-weight: 600; color: var(--brand-dark); }
  .spec tbody tr:last-child th, .spec tbody tr:last-child td { border-bottom: 0; }
</style>
