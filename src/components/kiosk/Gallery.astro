---
// Fotoğraf galerisi: küçük resme tıklayınca büyük hali açılır; isteğe bağlı indir/paylaş bağlantıları.
import type { Photo } from '../../data/galeri';
import { generalInformation } from '../../data/generalInformation';

interface Props {
  photos: Photo[];
  actions?: boolean;
  eager?: boolean;
}
const { photos, actions = true, eager = false } = Astro.props;
const shareUrl = (p: Photo) => `https://wa.me/?text=${encodeURIComponent(`${p.alt} – ${generalInformation.url}${p.download}`)}`;
---

<ul class="gallery" data-gallery>
  {photos.map((p) => (
    <li>
      <a class="g-thumb" href={p.large} data-full={p.large} data-alt={p.alt} aria-label={`${p.alt} – büyüt`}>
        <img src={p.thumb} alt={p.alt} width={Math.round(p.w / 2)} height={Math.round(p.h / 2)} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      </a>
      {actions && (
        <div class="g-actions">
          <a href={p.download} download={`${p.id}.jpg`}>İndir</a>
          <a href={shareUrl(p)} target="_blank" rel="noopener">WhatsApp'ta paylaş</a>
        </div>
      )}
    </li>
  ))}
</ul>

<dialog class="lightbox" id="lightbox" aria-label="Görsel önizleme">
  <button class="lb-close" type="button" aria-label="Kapat">×</button>
  <img alt="" />
  <p class="lb-cap"></p>
</dialog>

<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (box && !box.dataset.ready) {
    box.dataset.ready = '1';
    const img = box.querySelector('img') as HTMLImageElement;
    const cap = box.querySelector('.lb-cap') as HTMLElement;
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a.g-thumb') as HTMLAnchorElement | null;
      if (a && typeof box.showModal === 'function') {
        e.preventDefault();
        img.src = a.dataset.full!;
        img.alt = a.dataset.alt || '';
        cap.textContent = a.dataset.alt || '';
        box.showModal();
      } else if (e.target === box || (e.target as HTMLElement).classList.contains('lb-close')) {
        box.close();
      }
    });
  }
</script>

<style>
  .gallery { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); margin: 0; padding: 0; list-style: none; }
  li { display: flex; flex-direction: column; overflow: hidden; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  /* küçük resim kutusu: oran kesin 4:5, görsel kutunun içinde mutlak konumlu ve ortalı */
  .g-thumb { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #fff; cursor: zoom-in; }
  .g-thumb img { position: absolute; inset: .6rem; display: block; width: calc(100% - 1.2rem); height: calc(100% - 1.2rem); object-fit: contain; object-position: center; }
  .g-actions { display: flex; flex-wrap: wrap; gap: .3rem .9rem; padding: .5rem .8rem .7rem; font-size: .85rem; background: var(--brand-soft); border-top: 1px solid var(--line); }

  .lightbox { max-width: 96vw; max-height: 96vh; padding: 0; overflow: visible; background: transparent; border: 0; }
  .lightbox::backdrop { background: rgba(10, 12, 40, .82); }
  .lightbox img { display: block; max-width: 92vw; max-height: 82vh; margin: auto; background: #fff; border-radius: var(--radius-md); }
  .lb-cap { margin: .6rem 0 0; color: #fff; text-align: center; }
  .lb-close { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: #fff; color: var(--brand-dark); font-size: 1.6rem; line-height: 1; cursor: pointer; }
</style>
