---
import { generalInformation, waLink } from '../../data/generalInformation';
import { products } from '../../data/products';
import { useCases } from '../../data/useCases';
import { locations } from '../../data/locations';
import { nedirPages } from '../../data/nedir';
---

<footer class="ftr">
  <div class="container ftr-grid">
    <div>
      <h2>Vectanom Kiosk</h2>
      <p>Express Bilgisayar markası. Konya merkezli, Türkiye geneline kiosk çözümleri.</p>
      <p><a href={`tel:${generalInformation.phoneTel}`}>{generalInformation.phoneDisplay}</a><br /><a href={`mailto:${generalInformation.email}`}>{generalInformation.email}</a><br /><a href={waLink()} target="_blank" rel="noopener">WhatsApp ile yazın</a></p>
    </div>
    <div>
      <h2>Ürünler</h2>
      <ul>{products.map((p) => <li><a href={`/urunler/${p.slug}/`}>{p.name}</a></li>)}</ul>
    </div>
    <div>
      <h2>Kullanım Alanları</h2>
      <ul>{useCases.map((s) => <li><a href={`/kullanim-alanlari/${s.slug}/`}>{s.name}</a></li>)}<li><a href="/uygun-maliyetli-kiosk/">Uygun Maliyetli Kiosk</a></li></ul>
    </div>
    <div>
      <h2>Konya</h2>
      <ul>
        <li><a href="/konya-kiosk/">Konya Kiosk</a></li>
        {locations.map((l) => <li><a href={`/hizmet-bolgeleri/${l.slug}/`}>{l.name} Kiosk</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Kurumsal</h2>
      <ul>
        {nedirPages.map((n) => <li><a href={`/${n.slug}/`}>{n.h1}</a></li>)}
        <li><a href="/hakkimizda/">Hakkımızda</a></li>
        <li><a href="/kendi-kioskunu-olustur/">Kendi Kioskunu Oluştur</a></li>
        <li><a href="/referanslar/">Referanslar</a></li>
        <li><a href="/sss/">Sık Sorulan Sorular</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/bayilik/">Bayilik</a></li>
        <li><a href="/iletisim/">İletişim</a></li>
      </ul>
    </div>
  </div>
  <div class="container ftr-bot">© {new Date().getFullYear()} Vectanom Kiosk · konyakiosk.com</div>
</footer>

<style>
  .ftr { padding: 3rem 0 1rem; background: var(--footer-bg); color: #c9cdea; font-size: .95rem; }
  a { color: #c9cdea; text-decoration: none; }
  a:hover { color: #fff; text-decoration: underline; }
  h2 { color: #fff; font-size: 1.05rem; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { margin-bottom: .35rem; }
  .ftr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 2rem; }
  .ftr-bot { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #2a2f63; font-size: .88rem; }
</style>
