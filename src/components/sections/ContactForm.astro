---
import { waLink } from '../../data/generalInformation';
import { products } from '../../data/products';
import Dropdown from '../ui/Dropdown.astro';
interface Props {
  subject?: string;
}
const { subject = '' } = Astro.props;
---

<form id="contact-form" class="form" method="post" action="/api/iletisim" novalidate>
  <input type="hidden" name="page" value={subject} />
  <div class="hp" aria-hidden="true"><label>Boş bırakın <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label>Ad Soyad<input name="name" required autocomplete="name" /></label>
  <label>Telefon<input name="phone" type="tel" required autocomplete="tel" inputmode="tel" /></label>
  <label>E-posta (isteğe bağlı)<input name="email" type="email" autocomplete="email" /></label>
  <label>İlgilendiğiniz ürün
    <Dropdown name="product" label="İlgilendiğiniz ürün" placeholder="Seçiniz" options={[...products.map((p) => p.name), 'Emin değilim']} />
  </label>
  <label>Ekran boyutu
    <Dropdown name="size" label="Ekran boyutu" placeholder="Seçiniz" options={['21 inç', '24 inç', '32 inç', 'Emin değilim']} />
  </label>
  <label>Mesajınız<textarea name="message" rows="4" placeholder="Kullanım alanı, adet, şehir…"></textarea></label>
  <button class="btn" type="submit">Gönder</button>
  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="muted">Ya da doğrudan <a href={waLink()} target="_blank" rel="noopener">WhatsApp'tan yazın</a>.</p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector('.form-status') as HTMLElement | null;
  // "Kendi Kioskunu Oluştur" sayfasından gelen seçimleri mesaja ekle
  try {
    const cfg = sessionStorage.getItem('kiosk-config');
    const msg = form?.querySelector('textarea[name=message]') as HTMLTextAreaElement | null;
    if (cfg && msg && !msg.value) msg.value = cfg;
    sessionStorage.removeItem('kiosk-config');
  } catch {}
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    const data = new FormData(form);
    if (!String(data.get('name')).trim() || !String(data.get('phone')).trim()) {
      status.textContent = 'Lütfen ad soyad ve telefon alanlarını doldurun.';
      return;
    }
    status.textContent = 'Gönderiliyor…';
    try {
      const res = await fetch('/api/iletisim', { method: 'POST', body: data });
      if (!res.ok) throw new Error('fail');
      form.reset();
      status.textContent = 'Mesajınız alındı. En kısa sürede sizinle iletişime geçeceğiz.';
    } catch {
      const text = `Merhaba, iletişim formu: ${data.get('name')} - ${data.get('phone')} - ${data.get('product') || ''} ${data.get('size') || ''} ${data.get('message') || ''}`;
      status.innerHTML = 'Form gönderilemedi. <a href="https://wa.me/905075751463?text=' + encodeURIComponent(text) + '" target="_blank" rel="noopener">Bilgilerinizi WhatsApp ile gönderin</a>.';
    }
  });
</script>
