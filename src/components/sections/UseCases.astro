---
// Ana sayfadaki "Kullanım Alanına Göre Kiosk Çözümleri" kart ızgarası.
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import { useCases } from '../../data/useCases';
import { firstSentence } from '../../lib/text';
---

<Section title="Kullanım Alanına Göre Kiosk Çözümleri" tone="alt">
  <div class="grid">
    {useCases.map((s) => <Card href={`/kullanim-alanlari/${s.slug}/`} title={s.name} text={firstSentence(s.intro)} />)}
    <Card href="/uygun-maliyetli-kiosk/" title="Uygun Maliyetli Kiosk" text="Bütçenize göre doğru model ve donanım seçimi." />
  </div>
</Section>
