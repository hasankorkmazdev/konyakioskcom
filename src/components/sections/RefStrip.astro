import Section from '../ui/Section.astro';
import MoreLink from '../ui/MoreLink.astro';
import LogoStrip from '../kiosk/LogoStrip.astro';
import { references } from '../../data/references';
---

<Section>
  <h2>Çalıştığımız Kurumlar</h2>
  <LogoStrip refs={references} />
  <MoreLink href="/referanslar/" center>Tüm referanslar</MoreLink>
</Section>

<style>
  h2 { text-align: center; }
</style>
