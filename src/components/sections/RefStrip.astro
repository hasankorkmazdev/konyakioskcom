---
import { references } from '../../data/references';
import { logos } from '../../data/galeri';
---

<section class="section">
  <div class="container">
    <h2 style="text-align:center">Çalıştığımız Kurumlar</h2>
    <div class="logo-strip">
      {references.map((r) => (
        <a href={`/referanslar/#${r.slug}`} title={r.name} class={r.logoBg ? "dark" : ""}>
          {logos[r.slug] ? <img src={logos[r.slug].src} alt={r.name} width={logos[r.slug].w} height={logos[r.slug].h} loading="lazy" /> : <span>{r.name}</span>}
        </a>
      ))}
    </div>
    <p style="text-align:center;margin-top:1.2rem"><a href="/referanslar/">Tüm referanslar →</a></p>
  </div>
</section>
