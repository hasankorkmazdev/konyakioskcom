---
// Bayilik başvuru formu; gönderilemezse bilgileri WhatsApp mesajı olarak göndermeyi önerir.
import './form.css';
import Button from '../ui/Button.astro';
import Dropdown from '../ui/Dropdown.astro';
import { waLink } from '../../data/generalInformation';
---

<form id="dealer-form" class="form" method="post" action="/api/iletisim" novalidate>
  <input type="hidden" name="page" value="bayilik" />
  <div class="hp" aria-hidden="true"><label>Boş bırakın <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label>Ad Soyad<input name="name" required autocomplete="name" /></label>
  <label>Firma Adı<input name="company" required autocomplete="organization" /></label>
  <label>Telefon<input name="phone" type="tel" required autocomplete="tel" inputmode="tel" /></label>
  <label>E-posta<input name="email" type="email" required autocomplete="email" /></label>
  <label>Şehir / İlçe<input name="city" required autocomplete="address-level2" /></label>
  <label>Faaliyet alanınız
    <Dropdown name="field" label="Faaliyet alanınız" placeholder="Seçiniz" options={['Bilgisayar / IT satış ve servis', 'Yazılım / otomasyon', 'Ağ / güvenlik / sistem entegrasyonu', 'Diğer IT hizmetleri']} />
  </label>
  <label>Kendinizi kısaca tanıtın<textarea name="message" rows="4" placeholder="Deneyiminiz, müşteri çevreniz, hedeflediğiniz bölge…"></textarea></label>
  <Button type="submit">Başvuruyu Gönder</Button>
  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="muted">Ya da doğrudan <a href={waLink('Merhaba, Vectanom Kiosk bayiliği hakkında bilgi almak istiyorum.')} target="_blank" rel="noopener">WhatsApp'tan yazın</a>.</p>
</form>

<script>
  import { bindForm } from '../../scripts/form';

  const form = document.getElementById('dealer-form') as HTMLFormElement | null;
  if (form) {
    bindForm(form, {
      required: ['name', 'company', 'phone', 'email', 'city', 'field'],
      missing: 'Lütfen tüm zorunlu alanları doldurun.',
      success: 'Başvurunuz alındı. Bölgenizi kontrol edip en kısa sürede sizinle iletişime geçeceğiz.',
      fallback: (d) => `Merhaba, bayilik başvurusu: ${d.get('name')} - ${d.get('company')} - ${d.get('city')} - ${d.get('phone')} - ${d.get('field')}`,
    });
  }
</script>
