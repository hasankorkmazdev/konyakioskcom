---
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Sık Sorulan Sorular' } = Astro.props;
---

<section class="section">
  <div class="container narrow">
    <h2>{title}</h2>
    {items.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>
