---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
---

<Base title="Sayfa Bulunamadı | Vectanom Kiosk" description="Aradığınız sayfa bulunamadı." path="/404/" noindex>
  <Section width="narrow">
    <h1>Sayfa bulunamadı</h1>
    <p>Aradığınız sayfa taşınmış veya kaldırılmış olabilir.</p>
    <div class="btns">
      <Button href="/">Ana Sayfa</Button>
      <Button href="/urunler/" variant="secondary">Ürünler</Button>
    </div>
  </Section>
</Base>
