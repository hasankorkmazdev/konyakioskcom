---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import Cta from '../components/Cta.astro';
import { productGroups } from '../data/galeri';
---

<Base
  title="Kiosk Galerisi | Model ve Ürün Fotoğrafları – Vectanom Kiosk"
  description="Klavyeli, yatay, dikey, kütüphane, self-servis, ödeme ve tahsilat kiosk fotoğrafları. Görselleri indirin veya WhatsApp ile paylaşın."
  path="/galeri/"
  image={productGroups[0]?.photos[0]?.large}
  crumbs={[{ name: 'Galeri', path: '/galeri/' }]}
>
  <section class="page-head container">
    <h1>Kiosk Galerisi</h1>
    <p class="lead">Tüm kiosk modellerimizin fotoğrafları. Görsele tıklayarak büyütebilir, <strong>İndir</strong> ile kaydedebilir veya <strong>WhatsApp'ta paylaş</strong> ile müşterinize gönderebilirsiniz.</p>
    <ul class="gallery-nav">
      {productGroups.map((g) => <li><a href={`#${g.slug}`}>{g.title}</a></li>)}
      <li><a href="/referanslar/">Referans projeler →</a></li>
    </ul>
  </section>

  <section class="section">
    <div class="container">
      {productGroups.map((g) => (
        <div class="gallery-group" id={g.slug}>
          <h2>{g.title}</h2>
          <p class="muted">{g.blurb}</p>
          <Gallery photos={g.photos} />
        </div>
      ))}
    </div>
  </section>
  <Cta />
</Base>
