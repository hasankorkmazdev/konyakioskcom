---
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Section from '../../components/ui/Section.astro';
import PageHead from '../../components/ui/PageHead.astro';
import TagList from '../../components/ui/TagList.astro';
import Cta from '../../components/sections/Cta.astro';
import { locations } from '../../data/locations';
import { products } from '../../data/products';
import { useCases } from '../../data/useCases';
import { locative } from '../../lib/tr';

export function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const others = locations.filter((x) => x.slug !== l.slug);
---

<Base
  title={`${l.name} Kiosk | Kafe, Büfe, Belediye Kiosk – Vectanom`}
  description={`${l.name} kiosk: ${locative(l.name)} kafe, büfe, restoran, belediye ve kütüphane için dokunmatik kiosk çözümleri. Vectanom Kiosk, Konya.`}
  path={`/hizmet-bolgeleri/${l.slug}/`}
  crumbs={[{ name: 'Konya Kiosk', path: '/konya-kiosk/' }, { name: `${l.name} Kiosk`, path: `/hizmet-bolgeleri/${l.slug}/` }]}
>
  <PageHead title={`${l.name} Kiosk`} lead={l.text} width="narrow">
    <Button slot="actions" href="/iletisim/">İletişime Geçin</Button>
  </PageHead>

  <Section split>
    <div>
      <h2>{locative(l.name)} Sunduğumuz Modeller</h2>
      <ul class="ticks">{products.map((p) => <li><a href={`/urunler/${p.slug}/`}>{p.name}</a></li>)}</ul>
    </div>
    <div>
      <h2>Kullanım Alanları</h2>
      <ul class="ticks">{useCases.map((s) => <li><a href={`/kullanim-alanlari/${s.slug}/`}>{s.name}</a></li>)}</ul>
    </div>
  </Section>

  <Section title="Diğer Konya İlçeleri" tone="alt">
    <TagList items={others.map((o) => ({ label: o.name, href: `/hizmet-bolgeleri/${o.slug}/` }))} />
  </Section>
  <Cta />
</Base>
