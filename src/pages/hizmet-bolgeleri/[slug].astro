---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/sections/Cta.astro';
import { locations } from '../../data/locations';
import { products } from '../../data/products';
import { sectors } from '../../data/sectors';

export function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const others = locations.filter((x) => x.slug !== l.slug);
---

<Base
  title={`${l.name} Kiosk | Kafe, Büfe, Belediye Kiosk – Vectanom`}
  description={`${l.name} kiosk: ${l.name}'da kafe, büfe, restoran, belediye ve kütüphane için dokunmatik kiosk çözümleri. Vectanom Kiosk, Konya.`}
  path={`/hizmet-bolgeleri/${l.slug}/`}
  crumbs={[{ name: 'Konya Kiosk', path: '/konya-kiosk/' }, { name: `${l.name} Kiosk`, path: `/hizmet-bolgeleri/${l.slug}/` }]}
>
  <section class="page-head container narrow">
    <h1>{l.name} Kiosk</h1>
    <p class="lead">{l.text}</p>
    <div class="btns"><a class="btn" href="/iletisim/">İletişime Geçin</a></div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>{l.name}'da Sunduğumuz Modeller</h2>
        <ul class="ticks">{products.map((p) => <li><a href={`/urunler/${p.slug}/`}>{p.name}</a></li>)}</ul>
      </div>
      <div>
        <h2>Sektörler</h2>
        <ul class="ticks">{sectors.map((s) => <li><a href={`/sektorler/${s.slug}/`}>{s.name}</a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>Diğer Konya İlçeleri</h2>
      <ul class="tags">{others.map((o) => <li><a href={`/hizmet-bolgeleri/${o.slug}/`}>{o.name}</a></li>)}</ul>
    </div>
  </section>
  <Cta />
</Base>
