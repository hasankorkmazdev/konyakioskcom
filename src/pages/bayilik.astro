---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import PageHead from '../components/ui/PageHead.astro';
import Card from '../components/ui/Card.astro';
import DealerForm from '../components/forms/DealerForm.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import { generalInformation, waLink } from '../data/generalInformation';

const benefits = [
  { t: 'Uygun bayi fiyatı', d: 'Bayilere özel fiyatlandırma ile rekabetçi teklifler sunarsınız.' },
  { t: 'Şehrinizde tek bayi', d: 'Her şehirde yalnızca bir bayi ile çalışırız; bölgenizdeki talepler size yönlendirilir.' },
  { t: 'Eğitim ve bilgi desteği', d: 'Ürünler, kurulum ve satış süreci hakkında eğitim ve bilgi desteği alırsınız.' },
  { t: 'Proje ortaklıkları', d: 'Belediye, kurum ve işletme projelerinde birlikte teklif hazırlar, birlikte uygularız.' },
];
const steps = [
  { t: 'Başvuru', d: "Formu doldurun veya WhatsApp'tan yazın." },
  { t: 'Bölge kontrolü', d: 'Şehrinizde mevcut bir bayi olup olmadığına bakarız.' },
  { t: 'Görüşme', d: 'Çalışma şekli, fiyat ve eğitim konularını netleştiririz.' },
  { t: 'Bayilik', d: 'Anlaşma sonrası ürün ve eğitim sürecini başlatırız.' },
];
const faq = [
  { q: 'Bayilik şartları nelerdir?', a: 'IT sektöründe faaliyet gösteriyor olmanız ve başvurduğunuz şehirde başka bir Vectanom Kiosk bayisinin bulunmaması gerekir.' },
  { q: 'Şehrimde zaten bayi varsa başvurabilir miyim?', a: 'Her şehirde tek bayi ile çalıştığımız için o şehir için başvuru alamıyoruz. Başka bir şehir için başvurabilirsiniz.' },
  { q: 'Bayilere ne sağlıyorsunuz?', a: 'Uygun bayi fiyatı, eğitim ve bilgi desteği ile proje ortaklıkları sunuyoruz.' },
  { q: 'Başvurudan sonra ne olur?', a: 'Başvurunuz alındıktan sonra bölgenizi kontrol eder, uygunsa sizinle görüşme planlarız.' },
];
---

<Base
  title="Kiosk Bayilik | Vectanom Kiosk Bayisi Olun"
  description="Vectanom Kiosk bayisi olun. IT sektöründe faaliyet gösteren firmalara şehir bazlı tek bayilik, uygun fiyat, eğitim ve proje ortaklıkları."
  path="/bayilik/"
  crumbs={[{ name: 'Bayilik', path: '/bayilik/' }]}
  faq={faq}
>
  <PageHead title="Vectanom Kiosk Bayisi Olun" lead="IT sektöründe faaliyet gösteren firmalarla, şehir bazında tek bayi modeliyle çalışıyoruz." />

  <Section title="Bayilere Sunduklarımız">
    <div class="grid">
      {benefits.map((b) => <Card title={b.t} text={b.d} />)}
    </div>
  </Section>

  <Section tone="alt" split>
    <div>
      <h2>Bayilik Şartları</h2>
      <ul class="ticks">
        <li>IT sektöründe faaliyet gösteriyor olmak</li>
        <li>Başvurulan şehirde başka bir bayinin bulunmaması</li>
      </ul>
      <h2>Süreç Nasıl İşler?</h2>
      <ol>
        {steps.map((s) => <li><strong>{s.t}:</strong> {s.d}</li>)}
      </ol>
    </div>
    <div>
      <h2>Bayilik Başvurusu</h2>
      <DealerForm />
    </div>
  </Section>

  <Faq items={faq} title="Bayilik hakkında sık sorulanlar" />

  <Cta title="Bayilik hakkında görüşelim" text="Sorularınız için e-posta veya WhatsApp üzerinden bize ulaşın.">
    <Fragment slot="actions">
      <Button href={`mailto:${generalInformation.email}?subject=Bayilik`}>E-posta Gönderin</Button>
      <Button href={waLink('Merhaba, Vectanom Kiosk bayiliği hakkında bilgi almak istiyorum.')} external variant="secondary">WhatsApp</Button>
    </Fragment>
  </Cta>
</Base>
