---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import PageHead from '../components/ui/PageHead.astro';
import Card from '../components/ui/Card.astro';
import TagList from '../components/ui/TagList.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import { locations } from '../data/locations';
import { useCases } from '../data/useCases';

const faq = [
  { q: 'Konya\'da kiosk hizmeti veriyor musunuz?', a: 'Evet. Vectanom Kiosk, Express Bilgisayar markası olarak Konya merkezli çalışır ve tüm ilçelere kurulum ve teslimat sağlar.' },
  { q: 'Hangi ilçelere hizmet veriyorsunuz?', a: 'Selçuklu, Meram, Karatay, Ereğli, Akşehir, Beyşehir, Seydişehir, Çumra ve Konya\'nın diğer ilçeleri.' },
];
---

<Base
  title="Konya Kiosk | Kafe, Büfe, Belediye Kiosk Konya – Vectanom"
  description="Konya kiosk: Selçuklu, Meram, Karatay ve tüm ilçelerde kafe, büfe, restoran, belediye ve kütüphane kiosk çözümleri. Vectanom Kiosk."
  path="/konya-kiosk/"
  crumbs={[{ name: 'Konya Kiosk', path: '/konya-kiosk/' }]}
  faq={faq}
>
  <PageHead title="Konya Kiosk Çözümleri" lead="Konya'daki işletme, belediye ve kurumlara dokunmatik kiosk temin ediyoruz. Ürün seçiminden kuruluma ve destek sürecine kadar yanınızdayız.">
    <Button slot="actions" href="/iletisim/">İletişime Geçin</Button>
  </PageHead>

  <Section title="Konya İlçeleri">
    <div class="grid">
      {locations.map((l) => <Card href={`/hizmet-bolgeleri/${l.slug}/`} title={`${l.name} Kiosk`} text={`${l.text.split(';')[0]} için kiosk çözümleri.`} />)}
    </div>
  </Section>

  <Section title="Konya'da Kullanım Alanına Göre Kiosk" tone="alt">
    <TagList items={useCases.map((s) => ({ label: s.name, href: `/kullanim-alanlari/${s.slug}/` }))} />
  </Section>

  <Faq items={faq} />
  <Cta />
</Base>
