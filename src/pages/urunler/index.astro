---
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Section from '../../components/ui/Section.astro';
import PageHead from '../../components/ui/PageHead.astro';
import TagList from '../../components/ui/TagList.astro';
import ProductCard from '../../components/kiosk/ProductCard.astro';
import Cta from '../../components/sections/Cta.astro';
import { products } from '../../data/products';
---

<Base
  title="Kiosk Modelleri: Klavyeli, Yatay, Dikey, Kütüphane | Vectanom"
  description="Klavyeli, yatay, dikey ve kütüphane kiosk modelleri. 21, 24 ve 32 inç dokunmatik ekran seçenekleri. Vectanom Kiosk ürün gamı."
  path="/urunler/"
  crumbs={[{ name: 'Ürünler', path: '/urunler/' }]}
>
  <PageHead title="Kiosk Modelleri" lead="Kullanım alanınıza uygun kiosk modelleri; ekran, RAM ve disk seçeneklerini de kendiniz belirleyebilirsiniz." />
  <Section>
    <div class="grid">
      {products.map((p) => (
        <ProductCard product={p} text={p.description}>
          <TagList items={p.tags} />
        </ProductCard>
      ))}
    </div>
  </Section>
  <Section title="Kendi kioskunu oluştur" tone="alt">
    <p>Model, ekran, RAM, disk ve ek donanımı seçin; varsayılan 4 GB RAM, 256 GB SSD, 21.5 inç ekran.</p>
    <Button href="/kendi-kioskunu-olustur/">Kendi Kioskunu Oluştur</Button>
  </Section>
  <Cta />
</Base>
