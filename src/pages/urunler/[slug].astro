---
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Section from '../../components/ui/Section.astro';
import PageHead from '../../components/ui/PageHead.astro';
import TagList from '../../components/ui/TagList.astro';
import MoreLink from '../../components/ui/MoreLink.astro';
import ProductCard from '../../components/kiosk/ProductCard.astro';
import ProductCover from '../../components/kiosk/ProductCover.astro';
import Gallery from '../../components/kiosk/Gallery.astro';
import Faq from '../../components/sections/Faq.astro';
import Cta from '../../components/sections/Cta.astro';
import { photosOf, productPhotoGroups } from '../../data/galeri';
import { products } from '../../data/products';
import { useCases } from '../../data/useCases';
import { nedirPages } from '../../data/nedir';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const related = useCases.filter((s) => s.recommended.includes(p.slug));
const photos = photosOf(...(productPhotoGroups[p.slug] ?? []));
const guides = nedirPages.filter((n) => n.product === p.slug);
const others = products.filter((x) => x.slug !== p.slug);
---

<Base title={p.title} description={p.description} path={`/urunler/${p.slug}/`} image={photos[0]?.download} crumbs={[{ name: 'Ürünler', path: '/urunler/' }, { name: p.name, path: `/urunler/${p.slug}/` }]} faq={p.faq}>
  <PageHead title={p.h1} lead={p.intro}>
    <TagList items={p.tags} />
    <Fragment slot="actions">
      <Button href="/iletisim/">İletişime Geçin</Button>
      <Button href="/kendi-kioskunu-olustur/" variant="secondary">Kendi Kioskunu Oluştur</Button>
    </Fragment>
    <ProductCover slot="figure" slug={p.slug} size="large" eager />
  </PageHead>

  <Section split>
    <div>
      <h2>Özellikler</h2>
      <ul class="ticks">{p.features.map((f) => <li>{f}</li>)}</ul>
    </div>
    <div>
      <h2>Kullanım Alanları</h2>
      <ul class="ticks">{p.uses.map((u) => <li>{u}</li>)}</ul>
      {related.length > 0 && (
        <>
          <h3>Kullanım alanları</h3>
          <TagList items={related.map((s) => ({ label: s.name, href: `/kullanim-alanlari/${s.slug}/` }))} />
        </>
      )}
    </div>
  </Section>

  {photos.length > 1 && (
    <Section title={`${p.name} Fotoğrafları`} tone="alt">
      <Gallery photos={photos} />
      <MoreLink href="/urunler/">Tüm kiosk modelleri</MoreLink>
    </Section>
  )}

  <Section title="Diğer Modeller">
    <div class="grid">
      {others.map((o) => <ProductCard product={o} text={o.tags.join(' · ')} cover={false} />)}
    </div>
  </Section>

  {guides.length > 0 && (
    <Section title="Rehberler">
      <TagList items={guides.map((g) => ({ label: g.h1, href: `/${g.slug}/` }))} />
    </Section>
  )}

  <Faq items={p.faq} />
  <Cta />
</Base>
