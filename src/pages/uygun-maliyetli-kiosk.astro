---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import PageHead from '../components/ui/PageHead.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';

const faq = [
  { q: 'Ucuz kiosk almak mantıklı mı?', a: 'Kiosk sürekli çalışan bir cihazdır. Yalnızca başlangıç maliyetine bakmak yerine ekran kalitesi, gövde dayanımı ve destek süresini birlikte değerlendirmek gerekir.' },
  { q: 'Maliyeti nasıl düşürebilirim?', a: 'Gereksiz donanımı çıkararak (ör. kamera veya klavye), ekran boyutunu ihtiyaca göre seçerek ve yalnızca gerekli çevre birimlerini ekleyerek maliyet optimize edilebilir.' },
];
---

<Base
  title="Uygun Maliyetli Kiosk | Bütçenize Uygun Kiosk – Vectanom"
  description="Bütçenize uygun kiosk seçimi: doğru ekran boyutu, model ve donanımla maliyeti optimize edin. Vectanom Kiosk Konya."
  path="/uygun-maliyetli-kiosk/"
  crumbs={[{ name: 'Uygun Maliyetli Kiosk', path: '/uygun-maliyetli-kiosk/' }]}
  faq={faq}
>
  <PageHead title="Uygun Maliyetli Kiosk Nasıl Seçilir?" lead="Bütçenize uygun kiosk, en ucuz kiosk demek değildir; ihtiyacınıza tam uyan, gereksiz donanım içermeyen ve uzun süre sorunsuz çalışan kiosktur." width="narrow" class="prose">
    <h2>Maliyeti belirleyen unsurlar</h2>
    <ul class="ticks">
      <li>Ekran boyutu: 21, 24 veya 32 inç</li>
      <li>Model: yatay, dikey, klavyeli, kütüphane</li>
      <li>Çevre birimleri: yazıcı, barkod/QR okuyucu, kamera, POS</li>
      <li>Gövde ve kullanım yeri: iç mekan, yoğun kullanım</li>
      <li>Yazılım ve kurulum ihtiyacı</li>
    </ul>
    <h2>Doğru başlangıç</h2>
    <p>Kullanım alanınızı, günlük kullanıcı sayınızı ve ihtiyaç duyduğunuz çevre birimlerini bize iletin; gereksiz özellikler için ödeme yapmadan size uygun yapılandırmayı birlikte belirleyelim.</p>
    <Fragment slot="actions">
      <Button href="/iletisim/">İletişime Geçin</Button>
      <Button href="/urunler/" variant="secondary">Modelleri İnceleyin</Button>
    </Fragment>
  </PageHead>
  <Faq items={faq} />
  <Cta />
</Base>
