---
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Section from '../../components/ui/Section.astro';
import PageHead from '../../components/ui/PageHead.astro';
import TagList from '../../components/ui/TagList.astro';
import Photo from '../../components/ui/Photo.astro';
import ProductCard from '../../components/kiosk/ProductCard.astro';
import KioskArt from '../../components/kiosk/KioskArt.astro';
import ContentSections from '../../components/kiosk/ContentSections.astro';
import Gallery from '../../components/kiosk/Gallery.astro';
import Faq from '../../components/sections/Faq.astro';
import Cta from '../../components/sections/Cta.astro';
import { photosOf, useCaseCover, useCasePhotoGroups } from '../../data/galeri';
import { useCases } from '../../data/useCases';
import { products } from '../../data/products';
import { nedirPages } from '../../data/nedir';

export function getStaticPaths() {
  return useCases.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const photos = photosOf(...(useCasePhotoGroups[s.slug] ?? []));
const coverPhoto = useCaseCover(s.slug); // liste kartındaki görselle aynı
const recs = products.filter((p) => s.recommended.includes(p.slug));
const guides = nedirPages.filter((n) => n.useCases.includes(s.slug));
// Ayrıntılı (sections içeren) sayfalarda başlığın yanında kapak görseli, yoksa kiosk çizimi (yer tutucu)
const cover = !!s.sections;
---

<Base title={s.title} description={s.description} path={`/kullanim-alanlari/${s.slug}/`} image={coverPhoto?.download} crumbs={[{ name: 'Kullanım Alanları', path: '/kullanim-alanlari/' }, { name: s.name, path: `/kullanim-alanlari/${s.slug}/` }]} faq={s.faq}>
  <PageHead title={s.h1} lead={s.intro}>
    <Button slot="actions" href="/iletisim/">İletişime Geçin</Button>
    {cover && <Fragment slot="figure">{coverPhoto ? <Photo photo={coverPhoto} size="large" eager /> : <KioskArt />}</Fragment>}
  </PageHead>

  {s.benefits && (
    <Section title="Sağladığı Faydalar" width="narrow">
      <ul class="ticks">{s.benefits.map((b) => <li>{b}</li>)}</ul>
    </Section>
  )}

  {s.sections && (
    <Section as="article" width="narrow" class="prose">
      <ContentSections sections={s.sections} />
    </Section>
  )}

  {recs.length > 0 && (
    <Section title="Önerilen Modeller" tone="alt">
      <div class="grid">
        {recs.map((p) => <ProductCard product={p} text={p.tags.join(' · ')} />)}
      </div>
      <p>Konya ve çevresinde hizmet veriyoruz: <a href="/konya-kiosk/">Konya kiosk</a>.</p>
    </Section>
  )}

  {photos.length > 0 && (
    <Section title="Örnek Görseller">
      <Gallery photos={photos} actions={false} />
    </Section>
  )}

  {guides.length > 0 && (
    <Section title="Rehberler">
      <TagList items={guides.map((g) => ({ label: g.h1, href: `/${g.slug}/` }))} />
    </Section>
  )}

  <Faq items={s.faq} />
  <Cta />
</Base>
