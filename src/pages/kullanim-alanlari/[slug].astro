---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/sections/Cta.astro';
import Faq from '../../components/sections/Faq.astro';
import Photo from '../../components/ui/Photo.astro';
import Gallery from '../../components/sections/Gallery.astro';
import { photosOf, productPhotoGroups, useCasePhotoGroups } from '../../data/galeri';
import { useCases } from '../../data/useCases';
import { products } from '../../data/products';
import { nedirPages } from '../../data/nedir';

export function getStaticPaths() {
  return useCases.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const photos = photosOf(...(useCasePhotoGroups[s.slug] ?? []));
const recs = products.filter((p) => s.recommended.includes(p.slug));
---

<Base title={s.title} description={s.description} path={`/kullanim-alanlari/${s.slug}/`} image={photos[0]?.large} crumbs={[{ name: 'Kullanım Alanları', path: '/kullanim-alanlari/' }, { name: s.name, path: `/kullanim-alanlari/${s.slug}/` }]} faq={s.faq}>
  <section class="page-head container">
    <h1>{s.h1}</h1>
    <p class="lead">{s.intro}</p>
    <div class="btns"><a class="btn" href="/iletisim/">İletişime Geçin</a></div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Sağladığı Faydalar</h2>
      <ul class="ticks">{s.benefits.map((b) => <li>{b}</li>)}</ul>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>Önerilen Modeller</h2>
      <div class="grid">
        {recs.map((p) => (
          <a class="card" href={`/urunler/${p.slug}/`}>
            {photosOf(...(productPhotoGroups[p.slug] ?? []))[0] && <Photo photo={photosOf(...(productPhotoGroups[p.slug] ?? []))[0]} alt={p.name} />}
            <h3>{p.name}</h3>
            <p>{p.tags.join(' · ')}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:1.2rem">Konya ve çevresinde hizmet veriyoruz: <a href="/konya-kiosk/">Konya kiosk</a>.</p>
    </div>
  </section>

  {photos.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Örnek Görseller</h2>
        <Gallery photos={photos} actions={false} />
      </div>
    </section>
  )}

  {nedirPages.some((n) => n.useCases.includes(s.slug)) && (
    <section class="section">
      <div class="container">
        <h2>Rehberler</h2>
        <ul class="tags">{nedirPages.filter((n) => n.useCases.includes(s.slug)).map((g) => <li><a href={`/${g.slug}/`}>{g.h1}</a></li>)}</ul>
      </div>
    </section>
  )}

  <Faq items={s.faq} />
  <Cta />
</Base>
