---
import Base from '../../layouts/Base.astro';
import Section from '../../components/ui/Section.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Cta from '../../components/sections/Cta.astro';
import { references } from '../../data/references';
import { getGroup, logos } from '../../data/galeri';

// Tüm kurumlar kart olarak listelenir; her kart kurumun kendi sayfasına (/referanslar/<slug>/) gider.
// Kartlar #slug kimliğini taşır: eski /referanslar/#slug linkleri ilgili karta düşer.
const items = references.map((r) => ({ ...r, photos: getGroup(r.group).photos, logo: logos[r.slug] }));
const withPhotos = items.filter((r) => r.photos.length);
---

<Base
  title="Referanslar | Belediye ve Kurum Kiosk Projeleri – Vectanom"
  description="Konya Büyükşehir, Sivas ve Iğdır belediyeleri, KOSKİ ve KASKİ için tahsilat kioskları; Necmettin Erbakan Üniversitesi ve Çukurova Havalimanı projeleri."
  path="/referanslar/"
  image={withPhotos[0]?.photos[0]?.download}
  crumbs={[{ name: 'Referanslar', path: '/referanslar/' }]}
>
  <PageHead title="Referanslar" lead="Çalıştığımız kurumlar ve hayata geçirdiğimiz kiosk projeleri: belediye ve su idarelerinde tahsilat kioskları, üniversite ve havalimanı projeleri." />

  <Section>
    <div class="refs">
      {items.map((r) => (
        <a class="ref" href={`/referanslar/${r.slug}/`} id={r.slug}>
          <div class:list={['ref-logo', { dark: r.logoBg }]}>{r.logo ? <img src={r.logo.src} alt={`${r.name} logosu`} width={r.logo.w} height={r.logo.h} loading="lazy" /> : <strong>{r.name}</strong>}</div>
          {r.photos[0] && <div class="ref-img"><img src={r.photos[0].thumb} alt={r.photos[0].alt} loading="lazy" width={Math.round(r.photos[0].w / 2)} height={Math.round(r.photos[0].h / 2)} /></div>}
          <div class="ref-body"><strong class="ref-name">{r.name}</strong><p>{r.note}</p><span class="ref-more">İncele <span aria-hidden="true">→</span></span></div>
        </a>
      ))}
    </div>
  </Section>

  <Cta text="Kurumunuz için kiosk tahsilat veya bilgilendirme çözümü mü arıyorsunuz? Projenizi anlatın." />
</Base>

<style>
  .refs { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .ref { display: flex; flex-direction: column; overflow: hidden; color: var(--ink); text-decoration: none; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); scroll-margin-top: 70px; transition: box-shadow .15s, transform .15s; }
  .ref:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
  .ref-logo { display: grid; place-items: center; height: 96px; padding: .8rem 1rem; background: #fff; border-bottom: 1px solid var(--line); }
  .ref-logo.dark { background: var(--brand-dark); }
  .ref-logo img { max-height: 68px; width: auto; max-width: 85%; object-fit: contain; }
  .ref-logo strong { color: var(--brand-dark); font-size: 1.1rem; text-align: center; }
  .ref-img { aspect-ratio: 4 / 3; overflow: hidden; background: #f3f4fb; }
  .ref-img img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .ref-body { display: flex; flex-direction: column; flex: 1; padding: .8rem 1rem 1rem; }
  .ref-body p { margin: 0; color: var(--muted); font-size: .93rem; }
  .ref-name { display: block; margin-bottom: .2rem; color: var(--brand-dark); }
  .ref-more { margin-top: auto; padding-top: .6rem; color: var(--brand); font-weight: 600; font-size: .93rem; }
</style>
