---
// "... nedir?" sayfaları: içerik src/data/nedir.ts içinde, adres /<slug>/.
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import PageHead from '../components/ui/PageHead.astro';
import TagList from '../components/ui/TagList.astro';
import MoreLink from '../components/ui/MoreLink.astro';
import Photo from '../components/ui/Photo.astro';
import ContentSections from '../components/kiosk/ContentSections.astro';
import Gallery from '../components/kiosk/Gallery.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import { nedirPages } from '../data/nedir';
import { products } from '../data/products';
import { useCases } from '../data/useCases';
import { photosOf, productPhotoGroups } from '../data/galeri';
import { generalInformation } from '../data/generalInformation';
import { buildArticleJsonLd } from '../lib/seo';
import { formatDate } from '../lib/text';

export function getStaticPaths() {
  return nedirPages.map((n) => ({ params: { slug: n.slug }, props: { n } }));
}
const { n } = Astro.props;
const product = products.find((p) => p.slug === n.product)!;
const photos = photosOf(...(productPhotoGroups[n.product] ?? []));
const cases = useCases.filter((u) => n.useCases.includes(u.slug));
const related = nedirPages.filter((x) => n.related.includes(x.slug));
const path = `/${n.slug}/`;
const articleLd = buildArticleJsonLd({ title: n.h1, description: n.description, path, published: n.published, modified: n.modified, image: photos[0]?.download });
---

<Base title={n.title} description={n.description} path={path} type="article" image={photos[0]?.download} crumbs={[{ name: n.h1, path }]} faq={n.faq}>
  <script type="application/ld+json" set:html={articleLd} />
  <PageHead title={n.h1} lead={n.intro}>
    <p class="post-meta">Yazan: <strong>{generalInformation.author}</strong> · Yayın: <time datetime={n.published}>{formatDate(n.published)}</time>{n.modified !== n.published && <> · Güncelleme: <time datetime={n.modified}>{formatDate(n.modified)}</time></>}</p>
    <Fragment slot="actions">
      <Button href="/iletisim/">Teklif Alın</Button>
      <Button href={`/urunler/${product.slug}/`} variant="secondary">{product.name}</Button>
    </Fragment>
    {photos[0] && <Photo slot="figure" photo={photos[0]} size="large" alt={n.photoAlt} eager />}
  </PageHead>

  <Section as="article" width="narrow" class="prose">
    <p class="summary">{n.summary}</p>
    <ContentSections sections={n.sections} />
  </Section>

  <Section title={`Bizim Çözümümüz: ${product.name}`} tone="alt">
    <p>{product.intro}</p>
    <TagList items={product.tags} />
    {photos.length > 1 && <Gallery photos={photos} />}
    <MoreLink href={`/urunler/${product.slug}/`}>{product.name} detayları</MoreLink>
  </Section>

  {(cases.length > 0 || related.length > 0) && (
    <Section>
      {cases.length > 0 && (
        <>
          <h2>İlgili Kullanım Alanları</h2>
          <TagList items={cases.map((u) => ({ label: u.name, href: `/kullanim-alanlari/${u.slug}/` }))} />
        </>
      )}
      {related.length > 0 && (
        <>
          <h2>Bunlara da Bakın</h2>
          <TagList items={related.map((r) => ({ label: r.h1, href: `/${r.slug}/` }))} />
        </>
      )}
    </Section>
  )}

  <Faq items={n.faq} />
  <Cta />
</Base>
