---
import Base from '../../layouts/Base.astro';
import Section from '../../components/ui/Section.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Card from '../../components/ui/Card.astro';
import { posts } from '../../data/posts';
---

<Base
  title="Kiosk Blog | Rehberler ve İpuçları – Vectanom Kiosk"
  description="Kiosk nedir, kafe için kiosk nasıl seçilir, belediyelerde kiosk ne işe yarar? Kiosk seçimi ve kullanım alanları hakkında pratik rehberler."
  path="/blog/"
  crumbs={[{ name: 'Blog', path: '/blog/' }]}
>
  <PageHead title="Blog" />
  <Section>
    <div class="grid">
      {posts.map((p) => <Card href={`/blog/${p.slug}/`} title={p.title} text={p.description} />)}
    </div>
  </Section>
</Base>
