---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/posts';
---

<Base
  title="Kiosk Blog | Rehberler ve İpuçları – Vectanom Kiosk"
  description="Kiosk nedir, kafe için kiosk nasıl seçilir, belediyelerde kiosk ne işe yarar? Kiosk seçimi ve kullanım alanları hakkında pratik rehberler."
  path="/blog/"
  crumbs={[{ name: 'Blog', path: '/blog/' }]}
>
  <section class="page-head container"><h1>Blog</h1></section>
  <section class="section">
    <div class="container grid">
      {posts.map((p) => (
        <a class="card" href={`/blog/${p.slug}/`}>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
