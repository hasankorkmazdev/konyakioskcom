---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import Cta from '../components/Cta.astro';
import { references } from '../data/references';
import { getGroup, logos } from '../data/galeri';

const items = references.map((r) => ({ ...r, g: getGroup(r.group), logo: logos[r.slug] })).filter((r) => r.g.photos.length);
---

<Base
  title="Referanslar | Belediye Kiosk Tahsilat Projeleri – Vectanom Kiosk"
  description="Konya Büyükşehir Belediyesi, KOSKİ, KASKİ, Sivas ve Iğdır Belediyesi dahil kurumlar için hayata geçirilen kiosk tahsilat projeleri."
  path="/referanslar/"
  image={items[0]?.g.photos[0]?.large}
  crumbs={[{ name: 'Referanslar', path: '/referanslar/' }]}
>
  <section class="page-head container">
    <h1>Referanslar</h1>
    <p class="lead">Çalıştığımız kurumlar ve hayata geçirdiğimiz kiosk tahsilat projeleri.</p>
  </section>

  <section class="section">
    <div class="container refs">
      {items.map((r) => (
        <a class="ref" href={`#${r.slug}`}>
          <div class={`ref-logo${r.logoBg ? " dark" : ""}`}>{r.logo ? <img src={r.logo} alt={`${r.name} logosu`} loading="lazy" /> : <strong>{r.name}</strong>}</div>
          <div class="ref-img"><img src={r.g.photos[0].thumb} alt={r.g.photos[0].alt} loading="lazy" width={r.g.photos[0].w / 2} height={r.g.photos[0].h / 2} /></div>
          <div class="ref-body"><p>{r.note}</p></div>
        </a>
      ))}
    </div>
  </section>

  {items.map((r) => (
    <section class="section alt" id={r.slug} style="scroll-margin-top:70px">
      <div class="container">
        <h2>{r.name}</h2>
        <p class="muted">{r.note}</p>
        <Gallery photos={r.g.photos} />
      </div>
    </section>
  ))}
  <Cta text="Kurumunuz için kiosk tahsilat veya bilgilendirme çözümü mü arıyorsunuz? Projenizi anlatın." />
</Base>
