---
// Tüm sayfaların ortak iskeleti: <head> bilgileri, üst menü, içerik, alt bilgi.
import '../styles/global.css';
import SeoHead from '../components/layout/SeoHead.astro';
import Header from '../components/layout/Header.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import Analytics from '../components/layout/Analytics.astro';
import type { Crumb, FaqItem } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: Crumb[];
  faq?: FaqItem[];
  type?: 'website' | 'article';
  noindex?: boolean;
  image?: string;
}

const { title, description, path, crumbs = [], faq = [], type = 'website', noindex = false, image } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <SeoHead {title} {description} {path} {crumbs} {faq} {type} {noindex} {image} />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <Header />
    <main id="icerik">
      <Breadcrumbs {crumbs} />
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <Analytics />
  </body>
</html>
